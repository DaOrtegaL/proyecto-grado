# Copiar a .env y ajustar. Nunca versionar el archivo .env.

# --- Base de datos ---
# 1 = base simulada con archivos JSON en mock-database/ (no requiere Docker).
# 0 = SQL Server (requiere Docker Compose y la variable DATABASE_URL).
MOCK_DATABASE=1

MSSQL_SA_PASSWORD=Msh_Lab_2026_Cambiar
DATABASE_URL="sqlserver://localhost:1433;database=msh_clm;user=sa;password=Msh_Lab_2026_Cambiar;trustServerCertificate=true;encrypt=true"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
# Secretos JWT: generar valores aleatorios de al menos 32 caracteres.
JWT_ACCESS_SECRET=cambiar-este-secreto-de-acceso-por-uno-aleatorio-largo
JWT_REFRESH_SECRET=cambiar-este-secreto-de-refresco-por-uno-aleatorio-largo
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Localización ---
DEFAULT_LOCALE=es
DEFAULT_TIMEZONE=America/Bogota

# --- Modo de operación ---
# SIMULATION habilita el simulador; LAB_AUTHORIZED permanece deshabilitado hasta contar con autorización.
EXECUTION_MODE=SIMULATION
LAB_MODE_ENABLED=false

# --- Datos de laboratorio (solo seed) ---
SEED_LAB_PASSWORD=Laboratorio_2026_Lab
SEED_RANDOM_SEED=20260101
SEED_STORES_PER_COUNTRY=3
SEED_TERMINALS_PER_STORE=3

# --- Operación ---
# Intervalo (segundos) del motor de vencimientos; 0 lo desactiva (también existe el barrido manual).
SCHEDULER_INTERVAL_SECONDS=0
# Límites de tasa por minuto (valores de producción por defecto).
RATE_LIMIT_PER_MIN=300
LOGIN_RATE_LIMIT_PER_MIN=10
# Reloj controlado para escenarios reproducibles (ISO-8601); vacío = hora real.
FIXED_NOW=
